{
  "dynamic": "false",
  "date_detection": false,
  "dynamic_templates": [
    {
      "entity_properties": {
        "path_match": "properties.*",
        "match_mapping_type": "string",
        "mapping": {
          "type": "keyword",
          "ignore_above": 8191,
          "copy_to": "propertiesAll",
          "fields": {
            "text": {
              "type": "text",
              "analyzer": "folding"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "entityType": { "type": "keyword" },
    "join": {
      "type": "object",
      "properties": {
        "name": { "type": "keyword" }
      }
    },
    "entityId": { "type": "keyword" },
    "model": { "type": "keyword" },
    "modelVersions": { "type": "keyword" },
    "type": { "type": "keyword" },
    "documentIds": { "type": "keyword" },
    "propertiesAll": {
      "type": "text",
      "analyzer": "folding"
    },
    "properties": {
      "type": "object",
      "dynamic": true
    }
  }
}
