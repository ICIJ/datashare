{
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "project id"
    },
    "doc_ids": {
      "type": "array",
      "description": "document ids to untag",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "query": {
      "type": "string",
      "description": "Elasticsearch query_string syntax selecting the documents to untag, instead of doc_ids"
    },
    "confirmed": {
      "type": "boolean",
      "description": "set only on the second call, after the user agreed to the count",
      "default": false
    },
    "tags": {
      "type": "array",
      "description": "tag labels to remove",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "project",
    "tags"
  ]
}
