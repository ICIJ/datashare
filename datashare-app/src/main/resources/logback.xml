<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <!-- stderr, not stdout: stdout carries CLI command results, JSON output included,
             and must stay parseable -->
        <target>System.err</target>
        <encoder>
            <pattern>%d [%thread] %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>./logs/datashare.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>./logs/datashare.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>5</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d [%thread] %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Drop benign, high-volume Apache POI parsing noise on legacy Office files;
         message-targeted so other POI diagnostics stay visible (see the filter class). -->
    <turboFilter class="org.icij.datashare.log.PoiNoiseTurboFilter" />

    <logger name="com.amazonaws.request" level="warn" />

    <!-- jcasbin's DomainManager.printRoles dumps the whole role graph at INFO on every policy
         load: noise on every command, and every user's roles in the terminal and the log file -->
    <logger name="org.casbin" level="warn" />

    <root level="info" additivity="false">
        <appender-ref ref="console"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
